ENVIRONMENT=development
# production 默认使用 Secure Cookie。仅 HTTP 调试时显式开启此开关。
ALLOW_INSECURE_HTTP=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wishin_app
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=wishindiary_db
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 模型 SHA-256：development 留空跳过校验；生产部署先运行 scripts/train.py 生成模型，
# 再用 scripts/inspect_model.py 查询实际值填入（不预设固定哈希）
MODEL_SHA256=

# ---- 可观测性（生产推荐开启）----
# 模型监控 JSONL 保留天数：超过后旧分片自动清理（0 = 永久保留）
MONITOR_RETENTION_DAYS=90
# 日志输出格式：json（生产）| text（本地开发可读）
LOG_FORMAT=json
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 是否暴露 Prometheus 文本格式 /metrics 端点
METRICS_ENABLED=false
# Sentry DSN；留空则完全禁用 Sentry（env 可开关）
SENTRY_DSN=
# Sentry 性能追踪采样率（0~1），仅 DSN 非空时生效
SENTRY_TRACES_SAMPLE_RATE=0.1
