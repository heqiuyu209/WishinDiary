ENVIRONMENT=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wishin_app
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
DB_NAME=wishindiary_db
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 模型 SHA-256：库不预设哈希。development 留空跳过校验；Docker 部署由 setup_docker.ps1
# 根据 scripts/train.py 生成的实际模型自动写入（scripts/inspect_model.py 可查看）。
MODEL_SHA256=
API_PORT=8000
WEB_PORT=8080
WEB_BIND_HOST=0.0.0.0
# HTTP 的 IP:端口调试设为 true；正式 HTTPS 部署保持 false。
ALLOW_INSECURE_HTTP=false
